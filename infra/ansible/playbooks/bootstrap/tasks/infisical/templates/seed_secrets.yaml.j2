{% for source in infisical_seed_sources %}
{% set prefix = source.prefix | default('') %}
{% set data = source.data | default({}) %}
{% for first_key, first_value in data.items() %}
{% if first_value is mapping %}
{% for second_key, second_value in first_value.items() %}
{% if second_value is string or second_value is number or second_value is boolean %}
- key: {{ ([prefix, first_key, second_key] | reject('equalto', '') | join('_') | upper) | to_json }}
  value: {{ second_value | string | to_json }}
{% endif %}
{% endfor %}
{% elif first_value is string or first_value is number or first_value is boolean %}
- key: {{ ([prefix, first_key] | reject('equalto', '') | join('_') | upper) | to_json }}
  value: {{ first_value | string | to_json }}
{% endif %}
{% endfor %}
{% endfor %}
